{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voz de la Novia",
  "mainBinaryName": "VozDeLaNovia",
  "version": "",
  "identifier": "org.vozdelanovia.escritorio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Tabernáculo Shalom Adonai",
    "shortDescription": "Alabanzas, Biblia y Mensaje en pantalla",
    "longDescription": "Voz de la Novia: letras y acordes, Biblia y Mensaje en el proyector y en OBS. Funciona sin internet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/vdn-server"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}